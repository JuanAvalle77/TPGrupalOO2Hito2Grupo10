<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "https://hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class name="datos.Personal" table="personal">
    	<!-- ID -->
        <id name="idPersonal" column="idPersonal">
            <generator class="identity"/>
        </id>
		<!-- Atributos - Columnas -->
        <property name="nombre" column="nombre" type="string" not-null="true"/>
        <property name="apellido" column="apellido" type="string" not-null="true"/>
        <property name="dni" column="dni" type="int" unique="true" not-null="true"/>
        <property name="fechaNacimiento" column="fechaNacimiento" type="java.time.LocalDate" not-null="true"/>
        <property name="fechaIngreso" column="fechaIngreso" type="java.time.LocalDate" not-null="true"/>
        <property name="sueldoBase" column="sueldoBase" type="double" not-null="true"/>
        <property name="contacto" column="contacto" type="string"/>

        <!-- Relacion Uno a Muchos (lado muchos): un Personal esta asignado a una UnidadVenta -->
        <many-to-one name="unidadVenta" class="datos.UnidadVenta" column="idUnidadVenta"/>

        <!-- Herencia: joined-subclass, una tabla por subclase -->
        <joined-subclass name="datos.Cajero" table="cajero">
        	<key column="idCajero"/>
        	<property name="turno" column="turno" type="string" not-null="true"/>
        	<property name="plus" column="plus" type="int" not-null="true"/>
        </joined-subclass>

        <joined-subclass name="datos.Cocinero" table="cocinero">
        	<key column="idCocinero"/>
        	<property name="especialidad" column="especialidad" type="string" not-null="true"/>
        	<property name="plusEspecialidad" column="plusEspecialidad" type="double" not-null="true"/>
        </joined-subclass>
    </class>
</hibernate-mapping>
