<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "https://hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class name="datos.UnidadVenta" table="unidadventa">
    	<!-- ID -->
        <id name="idUnidadVenta" column="idUnidadVenta">
            <generator class="identity"/>
        </id>
		<!-- Atributos - Columnas -->
        <property name="nombre" column="nombre" type="string" not-null="true"/>
        <property name="superficie" column="superficie" type="float" not-null="true"/>
        <property name="codigo" column="codigo" type="string" not-null="true" unique="true" length="10"/>

        <!-- Relacion Uno a Muchos (lado uno): un Festival tiene muchas UnidadVenta -->
        <many-to-one name="festival" class="datos.Festival" column="idFestival" not-null="true"/>

        <!-- responsable: un miembro puntual del Staff a cargo de la unidad -->
        <many-to-one name="responsable" class="datos.Personal" column="idPersonalResponsable" not-null="true"/>

        <!-- Relacion Uno a Muchos: una UnidadVenta tiene muchos Platos -->
        <set name="platos" table="plato" inverse="true" lazy="true" fetch="select">
            <key column="idUnidadVenta" not-null="true"/>
            <one-to-many class="datos.Plato"/>
        </set>

        <!-- Relacion Uno a Muchos: una UnidadVenta tiene muchos Pedidos -->
        <set name="pedidosRealizados" table="pedido" inverse="true" lazy="true" fetch="select">
            <key column="idUnidadVenta" not-null="true"/>
            <one-to-many class="datos.Pedido"/>
        </set>

        <!-- Relacion Uno a Muchos: una UnidadVenta administra su propio personal (lado inverso de Personal.unidadVenta) -->
        <!-- key sin not-null: coincide con Personal.hbm.xml, donde unidadVenta es opcional (personal recien ingresado puede no estar asignado aun) -->
        <set name="personal" table="personal" inverse="true" lazy="true" fetch="select">
            <key column="idUnidadVenta"/>
            <one-to-many class="datos.Personal"/>
        </set>

        <!-- Herencia: joined-subclass, una tabla por subclase -->
        <joined-subclass name="datos.FoodTruck" table="foodtruck">
        	<key column="idFoodTruck"/>
        	<property name="requiereElectricidad" column="requiereElectricidad" type="boolean" not-null="true"/>
        	<property name="patente" column="patente" type="string" not-null="true"/>
        </joined-subclass>

        <joined-subclass name="datos.PuestoDesarmable" table="puestodesarmable">
        	<key column="idPuestoDesarmable"/>
        	<property name="cantidadCarpas" column="cantidadCarpas" type="int" not-null="true"/>
        	<property name="tiempoMontaje" column="tiempoMontaje" type="int" not-null="true"/>
        </joined-subclass>
    </class>
</hibernate-mapping>
